import React, {useState} from 'react';
import{StyleSheet, Text, View, TouchableOpacity} from 'react-native';

export default function App(){
  const [nota, setNota] = useState('Nenhuma');

  return(
    <View style={styles.container}>
     <Text style={styles.titulo}>Como foi o atendimento?</Text>

    <View style={styles.linha}>
    <TouchableOpacity style={styles.botao} onPress={() => setNota('Rum 😔')}>
     <Text style={styles.emoji}>😔</Text>
    </TouchableOpacity>

     <TouchableOpacity style={styles.botao} onPress={() => setNota('Bom 😃')}>
     <Text style={styles.emoji}>😃</Text>
    </TouchableOpacity>

     <TouchableOpacity style={styles.botao} onPress={() => setNota('Ótimo 🤩')}>
     <Text style={styles.emoji}>🤩</Text>
    </TouchableOpacity>
  </View>

  <Text style={styles.resultado}>Avaliação selecionada: {nota}</Text>
</View>
  );
}

const styles = StyleSheet.create({
  container:{flex: 1, justifyContent: 'center', alignItems: 'center', padding: 20, backgroundColor: '#fff'},

  titulo:{fontSize: 18, fontWeight: 'bold', marginBottom: 20, color: '#0f172a'},
  linha:{flexDirection: 'row', gap: 15, marginBottom: 25},
  botao:{padding: 15, backgroundColor: '#f1f5f9', borderRadius: 12, borderWidth: 1, borderColor: 'cbd5e1',},
  emoji:{fontSize: 32},
  resultado:{fontSize: 16, fontWeight: 'bold', color:'#2563eb'},
});
